{
  "name": "clinomania",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": { "bindings": [{ "name": "BED", "class_name": "Bed" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Bed"] }],
  "ai": { "binding": "AI" },
  // Maverick - Commanding and Powerful (ElevenLabs voice library)
  "vars": { "ELEVENLABS_VOICE_ID": "V33LkP9pVLdcjeB2y5Na" },
  "observability": { "enabled": true }
}
